    }

    TICKET_ACTIVITIES {
        bigint id PK
        bigint ticket_id FK
        bigint user_id FK
        varchar performer_name
        varchar activity_type
        text description
        datetime created_at
    }

    TICKET_ATTACHMENTS {
        bigint id PK
        bigint ticket_id FK
        bigint uploaded_by_id FK
